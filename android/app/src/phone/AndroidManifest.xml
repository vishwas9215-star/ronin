<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Ronin Phone: Messages + Calls on their own (21 Nov 2026), so the browser stays free of SMS / call / accessibility
         permissions. No self-update and no camera here; Ronin Browser brings its updates. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="com.ronin.permission.SAVED_SMS" />

    <queries>
        <package android:name="com.ronin.browser" />
    </queries>

    <application
        android:label="Ronin Phone"
        android:icon="@mipmap/ic_calls"
        tools:replace="android:label,android:icon"
        tools:remove="android:banner">
        <!-- ===== Ronin Messages: the phone's SMS app ===== -->
        <activity
            android:name=".MessagesActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_messages"
            android:label="Ronin Messages"
            android:launchMode="singleTask"
            android:taskAffinity="com.ronin.browser.messages"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name=".MessagesLauncher"
            android:targetActivity=".MessagesActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_messages"
            android:label="Ronin Messages">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <receiver
            android:name=".SmsDeliverReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".MmsReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>
        <receiver android:name=".SmsSentReceiver" android:exported="false" />
        <receiver android:name=".OtpCopyReceiver" android:exported="false" />
        <service
            android:name=".HeadlessSmsSendService"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

        <!-- ===== Ronin Calls: the phone app (off until the family turns it on) ===== -->
        <activity
            android:name=".CallsActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_calls"
            android:label="Ronin Calls"
            android:launchMode="singleTask"
            android:taskAffinity="com.ronin.browser.calls"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name=".CallsLauncher"
            android:targetActivity=".CallsActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_calls"
            android:label="Ronin Calls">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity
            android:name=".InCallActivity"
            android:enabled="true"
            android:exported="false"
            android:excludeFromRecents="true"
            android:autoRemoveFromRecents="true"
            android:label="Ronin Call"
            android:launchMode="singleInstance"
            android:taskAffinity="com.ronin.browser.incall"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />
        <service
            android:name=".RoninInCallService"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data android:name="android.telecom.IN_CALL_SERVICE_UI" android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>
        <service
            android:name=".RoninCallScreen"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>
        <receiver android:name=".CallActionReceiver" android:enabled="true" android:exported="false" />
        <service
            android:name=".RecordService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <service
            android:name=".RecordAccess"
            android:enabled="true"
            android:exported="true"
            android:label="Ronin Calls: call recording"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/record_access" />
        </service>

    </application>
</manifest>
