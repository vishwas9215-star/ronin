<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ronin Agent Lab: the pilot of "Claude works inside the owner's own Ronin" (27 Nov 2026). Separate app id
         (com.ronin.agentlab), so tests on the real phone / tablet never touch Ronin Browser or its data. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- the census helper on this phone (same signing key): C reads / fills the Census app through it -->
    <uses-permission android:name="com.ronin.census.permission.DRIVE" />
    <queries><package android:name="com.ronin.census" /></queries>
    <application>
        <!-- keeps the Claude tab and its link alive while the owner uses other apps (a small notification) -->
        <service
            android:name="com.ronin.browser.agent.AgentKeepAlive"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the owner's own browser tab linked so his assistant can finish the task he asked for while he uses other apps" />
        </service>
        <activity
            android:name="com.ronin.browser.agent.AgentActivity"
            android:exported="true"
            android:label="Ronin Agent Lab"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
