<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Ronin Messages / Ronin Calls (only when the family turns them on; the phone asks first) -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".RoninApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Ronin"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.Ronin">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <!-- WhatsApp / SMS -> Share -> Ronin: "क्या यह ठगी है?" -->
            <intent-filter android:label="Ronin: ठगी जाँचें">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- its own icon on the home screen: the family's email with Safe Mail -->
        <activity-alias
            android:name=".MailLauncher"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_mail"
            android:label="Ronin Mail">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".SafeMoneyActivity"
            android:exported="false"
            android:label="Ronin Safe Money"
            android:taskAffinity="com.ronin.browser.safemoney"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode" />

        <!-- ===== Ronin Messages: the phone's SMS app (off until the family turns it on) ===== -->
        <activity
            android:name=".MessagesActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_messages"
            android:label="Ronin Messages"
            android:launchMode="singleTask"
            android:taskAffinity="com.ronin.browser.messages"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name=".MessagesLauncher"
            android:targetActivity=".MessagesActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_messages"
            android:label="Ronin Messages">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <receiver
            android:name=".SmsDeliverReceiver"
            android:enabled="false"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".MmsReceiver"
            android:enabled="false"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>
        <receiver android:name=".SmsSentReceiver" android:exported="false" />
        <service
            android:name=".HeadlessSmsSendService"
            android:enabled="false"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

        <!-- ===== Ronin Calls: the phone app (off until the family turns it on) ===== -->
        <activity
            android:name=".CallsActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_calls"
            android:label="Ronin Calls"
            android:launchMode="singleTask"
            android:taskAffinity="com.ronin.browser.calls"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name=".CallsLauncher"
            android:targetActivity=".CallsActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_calls"
            android:label="Ronin Calls">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity
            android:name=".InCallActivity"
            android:enabled="false"
            android:exported="false"
            android:label="Ronin Call"
            android:launchMode="singleInstance"
            android:taskAffinity="com.ronin.browser.incall"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />
        <service
            android:name=".RoninInCallService"
            android:enabled="false"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data android:name="android.telecom.IN_CALL_SERVICE_UI" android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>
        <service
            android:name=".RoninCallScreen"
            android:enabled="false"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>
        <receiver android:name=".CallActionReceiver" android:enabled="false" android:exported="false" />
        <service
            android:name=".RecordService"
            android:enabled="false"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <service
            android:name=".RecordAccess"
            android:enabled="false"
            android:exported="true"
            android:label="Ronin Calls: call recording"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/record_access" />
        </service>

        <!-- Ronin SOS: its own red icon; off until chosen -->
        <activity
            android:name=".SosActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_sos"
            android:label="Ronin SOS"
            android:launchMode="singleTask"
            android:taskAffinity="com.ronin.browser.sos"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".SosService"
            android:enabled="false"
            android:exported="false"
            android:foregroundServiceType="location" />

        <activity
            android:name=".ChatLogActivity"
            android:exported="false"
            android:label="Ronin: Chat संदेश"
            android:taskAffinity="com.ronin.browser.chatlog"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode" />

        <!-- WhatsApp / chat / Gmail notifications checked for scams (the family allows it in Settings) -->
        <service
            android:name=".NotifyWatch"
            android:exported="true"
            android:label="Ronin: ठगी वाले संदेश की चेतावनी"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Ronin search on the home screen -->
        <receiver
            android:name=".SearchWidget"
            android:exported="true"
            android:label="Ronin Search">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/search_widget_info" />
        </receiver>
        <activity
            android:name=".SearchActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="com.ronin.browser.search"
            android:theme="@style/Theme.Ronin.Search"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />

        <service
            android:name=".MediaPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />


        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.ronin.browser.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
