<?xml version="1.0" encoding="utf-8"?>
<!-- Ronin search on the home screen: tap the bar to type, the round button to speak. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_bar"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@drawable/widget_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="6dp">
    <ImageView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:contentDescription="Ronin"
        android:src="@mipmap/ic_launcher" />
    <TextView
        android:id="@+id/widget_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="12dp"
        android:singleLine="true"
        android:text="Ronin में खोजें…"
        android:textColor="#C9D1E0"
        android:textSize="16sp" />
    <ImageView
        android:id="@+id/widget_mic"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_mic"
        android:contentDescription="बोलकर खोजें"
        android:padding="10dp"
        android:src="@android:drawable/ic_btn_speak_now"
        android:tint="#FFFFFF" />
</LinearLayout>
