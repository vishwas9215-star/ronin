<?xml version="1.0" encoding="utf-8"?>
<!-- Plain http is allowed for the router page, home servers and old government sites. Ronin still opens
     https first and shows "This site is not secure - Open anyway" only when a site has no https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
